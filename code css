/* RESET BASIQUE */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f0f0f0;
    color: #333;
    padding: 20px;
}

/* HEADER = */
header {
    background-color: #444;
    color: white;
    text-align: center;
    padding: 15px;
    margin-bottom: 20px;
}

header h1 {
    font-size: 24px;
    margin-bottom: 5px;
}

header p {
    font-size: 14px;
}

/* SECTIONS  */
section {
    background-color: white;
    border: 1px solid #ccc;
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 5px;
}

section h2 {
    font-size: 18px;
    margin-bottom: 10px;
    border-bottom: 1px solid #eee;
}

/*  LABELS  */
.label {
    font-size: 14px;
    margin: 5px 0;
}

/*  BARRES DE PROGRESSION  */
.progress-bar {
    width: 100%;
    background-color: #ddd;
    border-radius: 5px;
    margin: 10px 0;
}

.progress {
    height: 20px;
    text-align: center;
    color: white;
    font-size: 12px;
    border-radius: 5px;
}

/* Couleurs simples */
.green { background-color: #4caf50; }   /* 0-50% */
.orange { background-color: #ff9800; } /* 51-80% */
.red { background-color: #f44336; }    /* 81-100% */

/*  LISTE PROCESSUS */
ul {
    list-style-type: none;
    padding-left: 0;
}

li {
    padding: 5px;
    border-bottom: 1px solid #eee;
    font-size: 14px;
}

/*  FOOTER */
footer {
    text-align: center;
    font-size: 12px;
    color: #666;
    margin-top: 20px;
}

/* RESPONSIVE  */

/* Tablettes (768px - 1024px) */
@media (max-width: 1024px) {
    header h1 {
        font-size: 20px;
    }
    section {
        padding: 10px;
    }
    section h2 {
        font-size: 16px;
    }
    .progress {
        height: 18px;
        font-size: 11px;
    }
}

/* Smartphones (320px - 767px) */
@media (max-width: 767px) {
    body {
        padding: 10px;
    }
    header {
        padding: 10px;
    }
    header h1 {
        font-size: 18px;
    }
    header p {
        font-size: 12px;
    }
    section {
        margin-bottom: 15px;
        padding: 8px;
    }
    section h2 {
        font-size: 14px;
    }
    .progress {
        height: 15px;
        font-size: 10px;
    }
    li {
        font-size: 12px;
    }
    footer {
        font-size: 11px;
    }
}
